{
  "manifest_version": 3,
  "name": "NyoNyo AI Reminder",
  "version": "1.2",
  "description": "Pengingat belajar NyoNyo AI — otomatis buka tab ketika waktunya tiba! 🌸",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NyoNyo AI",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["demo.html", "demo.js", "reminder.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
